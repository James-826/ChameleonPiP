{
  "manifest_version": 3,
  "name": "ChameleonPiP 变色龙画中画",
  "version": "5.4.0",
  "homepage_url": "https://chameleonpip.site",
  "description": "像变色龙一样融进屏幕的 60fps 零边框画中画，3 种变色模式永久免费；支持 AI 防偷窥雷达、代码日志伪装字幕条、鼠标穿透与全球摸鱼耐力榜。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://chameleonpip.site wss://chameleonpip.site https://www.chameleonpip.site wss://www.chameleonpip.site ws://127.0.0.1:51937 http://127.0.0.1:51937 ws://127.0.0.1:51938 http://127.0.0.1:51938;"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChameleonPiP 变色龙画中画 (⌃⇧G)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hooks.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["gecko-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["stream-bridge.html", "stream-bridge.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-gecko-pip": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "MacCtrl+Shift+G"
      },
      "description": "投送 / 关闭 Mac 桌面无边框壁虎窗 (⌃Control + ⇧Shift + G)"
    },
    "toggle-boss-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "老板键：一键秒隐并暂停视频 (⌃Control + ⇧Shift + B)"
    }
  }
}
